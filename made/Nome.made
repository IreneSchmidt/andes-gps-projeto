project ToDoList {
	name: "ToDoList"
	description: "Sistema para organização de tarefas diárias"
	startDate: 2025-07-02

}





backlog Nome {
	name: "ToDoList"
	description: "Sistema para organização de tarefas diárias"
	epic Cadastro {
		name: "Cadastro e Autenticação"		description: "Usuário se cadastra e faz login"
}
	epic GerenciamentoTarefas {
		name: "Gerenciamento de Tarefas"		description: "Usuário cria, edita, exclui e altera status das tarefas"
}
	epic OrganizacaoTarefas {
		name: "Organização de Tarefas"		description: "Usuário organiza tarefas por categoria, data e status"
}
	epic Notificacoes {
		name: "Notificações"		description: "Sistema envia lembretes ao usuário"
}
	epic domaindiagram {
		name: "Create Problem Domain Modules"		description: "Create Problem Domain Modules"
		story createmodule_ToDoApp {
			name: "Create database infrastruture to module ToDoApp"
			task create_module {
				name: "Implements domain modules"


			}
			task create_repository {
				name: "Implements data repository"
				depends: Nome.domaindiagram.createmodule_ToDoApp.create_module

			}}}
}

